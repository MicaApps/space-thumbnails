<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>SpaceThumbnails.ControlPanel</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <StartupObject>SpaceThumbnails.ControlPanel.Program</StartupObject>
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240311000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.756" />
  </ItemGroup>

  <Target Name="UpdateRustDll" BeforeTargets="Build">
    <Message Text="Updating Rust DLL and restarting Explorer..." Importance="high" />
    <Exec Command="powershell -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\update_all.ps1&quot;" />
  </Target>

  <Target Name="CopyRustDllToOutput" AfterTargets="Build">
    <Message Text="Copying Rust DLL to output directory..." Importance="high" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\target\release\space_thumbnails_windows.dll" DestinationFolder="$(OutDir)" />
    <!-- Also copy the tools folder which is required for STEP conversion -->
    <ItemGroup>
      <ToolsFiles Include="$(MSBuildProjectDirectory)\..\tools\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ToolsFiles)" DestinationFolder="$(OutDir)\tools\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
